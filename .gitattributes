* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
.Renviron text eol=lf
.Rprofile text eol=lf
*.R text eol=lf
*.md text eol=lf
# Tracked CSV inputs retain their deposited bytes. Generated Step 1 files use a
# separate canonical table-content fingerprint for cross-platform validation.
*.csv binary
*.sql text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.cff text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
# This generated bootstrap file is synchronized byte-for-byte from renv 1.2.4;
# upstream indents otherwise blank lines, which should not be reported as a
# repository whitespace defect.
renv/activate.R -whitespace
